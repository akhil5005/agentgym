# Copy to backend/.env and edit. Never commit the real .env.
ENV=dev
DATABASE_URL=sqlite:///./agentgym.db
INGEST_API_KEY=dev-key
FRONTEND_ORIGIN=http://localhost:3000

# Postgres schema for AgentGym's tables. Leave empty when the database is
# AgentGym's alone; set it (e.g. agentgym) when sharing a Postgres with
# another project, so our generic table names cannot collide with theirs.
# Ignored on SQLite.
DB_SCHEMA=
